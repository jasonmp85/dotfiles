[user]
	name = Jason Petersen
	email = jason.petersen@datadoghq.com
	useconfigonly = true

[include]
	path = ~/.config/datadog/git/config
	path = ~/.config/git/config.local

[includeIf "hasconfig:remote.*.url:git@github.com:jasonmp85/**"]
	path = ~/.gitconfig-personal
[includeIf "hasconfig:remote.*.url:https://github.com/jasonmp85/**"]
	path = ~/.gitconfig-personal
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/jasonmp85/**"]
	path = ~/.gitconfig-personal

[credential]
	helper =

[core]
	autocrlf = input
	excludesfile = ~/.gitignore
	pager = diff-so-fancy | less --tabs=4 -RF
	whitespace = tabwidth=4
	fsmonitor = true
	untrackedCache = true

[color]
	ui = true

[color "diff-highlight"]
	oldnormal = red bold
	oldhighlight = red bold 52
	newnormal = green bold
	newhighlight = green bold 22

[color "diff"]
	meta = yellow
	frag = magenta bold
	commit = yellow bold
	old = red bold
	new = green bold
	whitespace = red reverse

[log]
	date = local

[rerere]
	enabled = true
	autoupdate = true

[alias]
	pushf = push --force-with-lease

[rebase]
	autosquash = true

[protocol]
	version = 2

[push]
	default = upstream

[interactive]
	singlekey = true

[tag]
	sort = version:refname

[mergetool "Kaleidoscope"]
	cmd = ksdiff --merge --output \"$MERGED\" --base \"$BASE\" -- \"$LOCAL\" --snapshot \"$REMOTE\" --snapshot
	trustExitCode = true

[merge]
	tool = Kaleidoscope
	conflictstyle = diff3

[difftool "Kaleidoscope"]
	cmd = ksdiff --partial-changeset --relative-path \"$MERGED\" -- \"$LOCAL\" \"$REMOTE\"

[difftool]
	prompt = false
	trustExitCode = true

[mergetool]
	prompt = false

[diff]
	tool = Kaleidoscope
[gpg]
  format = ssh
[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
[commit]
  gpgsign = true

[feature]
  manyFiles = true

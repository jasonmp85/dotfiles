-- Keep startup quiet; use :menu to list the custom helpers below.
\set QUIET 1

-- Prompt and completion.
-- %x exposes transaction state; %# distinguishes superusers.
\set PROMPT1 '%n@%m %~%x%# '
\set PROMPT2 '%w%R%# '
\set COMP_KEYWORD_CASE preserve-upper

-- A typo inside an interactive transaction rolls back only that statement.
-- Scripts retain PostgreSQL's normal fail-the-transaction behavior.
\set ON_ERROR_ROLLBACK interactive

-- Readable output for both narrow and wide terminals.  In wrapped format,
-- expanded=auto switches wide multi-column results to vertical output.
\pset format wrapped
\pset expanded auto
\pset border 2
\pset linestyle unicode
\pset null '∅'

-- Keep history separate by postgresql-common cluster when pg_wrapper provides
-- PGCLUSTER.  Direct clients fall back to their host and port.  Sanitize both
-- forms before using them in a filename (Unix-socket hosts contain slashes).
\unset history_cluster
\getenv history_cluster PGCLUSTER
\if :{?history_cluster}
  \set history_scope `printf '%s' :'history_cluster' | tr '/:' '--' | sed -e 's/^-*//' -e 's/-*$//'`
\else
  \set history_scope `printf '%s-%s' :'HOST' :'PORT' | tr '/:' '--' | sed -e 's/^-*//' -e 's/-*$//'`
\endif
\set HISTFILE ~/.psql_history- :history_scope - :USER - :DBNAME
\unset history_cluster
\unset history_scope

-- Keep a substantial history while allowing a leading space to suppress
-- sensitive commands.
\set HISTSIZE 100000
\set HISTCONTROL ignoreboth

\unset QUIET

-- Type :menu to list these helpers.  Each SQL variable includes its trailing
-- semicolon, so entering (for example) :activity executes it immediately.
\set menu '\\echo Helpers: activity blocking cache_hit conninfo dbsize index_size index_usage locks long_running_queries ps seq_scans settings show_slow_queries sp tablesize total_index_size unused_indexes uptime vacuum_stats waits clear ll'

-- Connections and server state.
\set activity 'SELECT datname, pid, usename, application_name, client_addr, backend_type, state, xact_start, query_start, wait_event_type, wait_event, query FROM pg_stat_activity ORDER BY query_start NULLS LAST, pid;'
\set conninfo 'SELECT usename, datname, application_name, state, count(*) AS connections FROM pg_stat_activity GROUP BY usename, datname, application_name, state ORDER BY connections DESC, usename, datname;'
\set ps 'SELECT pid, application_name AS source, clock_timestamp() - query_start AS running_for, state, wait_event_type, wait_event, query FROM pg_stat_activity WHERE state <> ''idle'' AND pid <> pg_backend_pid() ORDER BY query_start;'
\set long_running_queries 'SELECT pid, usename, application_name, clock_timestamp() - query_start AS duration, state, wait_event_type, wait_event, query FROM pg_stat_activity WHERE state <> ''idle'' AND pid <> pg_backend_pid() AND query_start < clock_timestamp() - interval ''5 minutes'' ORDER BY query_start;'
\set waits 'SELECT pid, usename, application_name, clock_timestamp() - query_start AS duration, wait_event_type, wait_event, query FROM pg_stat_activity WHERE state <> ''idle'' AND wait_event IS NOT NULL AND pid <> pg_backend_pid() ORDER BY query_start;'
\set uptime 'SELECT clock_timestamp() - pg_postmaster_start_time() AS uptime;'
\set settings 'SELECT category, name, setting, unit, context, pending_restart FROM pg_settings ORDER BY category, name;'

-- Locks.  pg_blocking_pids() handles more lock types than joining solely on
-- transaction IDs, which misses relation, tuple, advisory, and other locks.
\set blocking 'SELECT blocked.pid AS blocked_pid, blocked.usename AS blocked_user, blocked.query AS blocked_query, clock_timestamp() - blocked.query_start AS blocked_for, blocker.pid AS blocking_pid, blocker.usename AS blocking_user, blocker.query AS blocking_query, clock_timestamp() - blocker.query_start AS blocking_for FROM pg_stat_activity AS blocked CROSS JOIN LATERAL unnest(pg_blocking_pids(blocked.pid)) AS blockers(pid) JOIN pg_stat_activity AS blocker ON blocker.pid = blockers.pid ORDER BY blocked.query_start;'
\set locks 'SELECT l.pid, a.usename, l.locktype, l.mode, l.granted, n.nspname AS schema, c.relname AS relation, l.transactionid, clock_timestamp() - a.query_start AS query_age, a.query FROM pg_locks AS l LEFT JOIN pg_stat_activity AS a ON a.pid = l.pid LEFT JOIN pg_class AS c ON c.oid = l.relation LEFT JOIN pg_namespace AS n ON n.oid = c.relnamespace WHERE l.pid IS DISTINCT FROM pg_backend_pid() ORDER BY l.granted, a.query_start NULLS LAST, l.pid;'

-- Database and relation sizes.  Sort by bytes, not pg_size_pretty() text.
\set dbsize 'SELECT datname, pg_size_pretty(pg_database_size(datname)) AS size FROM pg_database ORDER BY pg_database_size(datname) DESC;'
\set tablesize 'SELECT schemaname || ''.'' || relname AS relation, pg_size_pretty(pg_total_relation_size(relid)) AS total_size, pg_size_pretty(pg_relation_size(relid)) AS table_size, pg_size_pretty(pg_indexes_size(relid)) AS indexes_size FROM pg_stat_user_tables ORDER BY pg_total_relation_size(relid) DESC LIMIT 40;'
\set index_size 'SELECT schemaname || ''.'' || indexrelname AS index, schemaname || ''.'' || relname AS relation, pg_size_pretty(pg_relation_size(indexrelid)) AS size FROM pg_stat_user_indexes ORDER BY pg_relation_size(indexrelid) DESC;'
\set total_index_size 'SELECT pg_size_pretty(COALESCE(sum(pg_indexes_size(relid)), 0)::bigint) AS size FROM pg_stat_user_tables;'

-- Statistics are cumulative since the last reset; interpret zero-use results
-- in that context before dropping an index.
\set cache_hit 'SELECT ''index'' AS cache, round(100.0 * sum(idx_blks_hit) / NULLIF(sum(idx_blks_hit + idx_blks_read), 0), 2) AS hit_percent FROM pg_statio_user_indexes UNION ALL SELECT ''table'' AS cache, round(100.0 * sum(heap_blks_hit) / NULLIF(sum(heap_blks_hit + heap_blks_read), 0), 2) AS hit_percent FROM pg_statio_user_tables;'
\set index_usage 'SELECT schemaname || ''.'' || relname AS relation, round(100.0 * idx_scan / NULLIF(seq_scan + idx_scan, 0), 2) AS index_scan_percent, seq_scan, idx_scan, n_live_tup AS estimated_rows FROM pg_stat_user_tables ORDER BY n_live_tup DESC;'
\set seq_scans 'SELECT schemaname || ''.'' || relname AS relation, seq_scan, seq_tup_read, n_live_tup AS estimated_rows FROM pg_stat_user_tables ORDER BY seq_scan DESC;'
\set unused_indexes 'SELECT COALESCE((SELECT stats_reset FROM pg_stat_database WHERE datname = current_database()), pg_postmaster_start_time()) AS statistics_since, ui.schemaname || ''.'' || ui.relname AS relation, ui.indexrelname AS index, pg_size_pretty(pg_relation_size(ui.indexrelid)) AS index_size, ui.idx_scan FROM pg_stat_user_indexes AS ui JOIN pg_index AS i ON i.indexrelid = ui.indexrelid WHERE ui.idx_scan = 0 AND NOT i.indisunique AND NOT i.indisprimary AND i.indisvalid AND pg_relation_size(ui.relid) > 5 * current_setting(''block_size'')::integer ORDER BY pg_relation_size(ui.indexrelid) DESC;'
\set vacuum_stats 'SELECT schemaname || ''.'' || relname AS relation, n_live_tup AS estimated_live_rows, n_dead_tup AS estimated_dead_rows, round(100.0 * n_dead_tup / NULLIF(n_live_tup + n_dead_tup, 0), 2) AS dead_row_percent, last_vacuum, last_autovacuum, last_analyze, last_autoanalyze, vacuum_count, autovacuum_count FROM pg_stat_user_tables ORDER BY n_dead_tup DESC, relname;'

-- Requires the pg_stat_statements extension in the current database.
\set show_slow_queries 'SELECT queryid, round(total_exec_time::numeric / 60000, 2) AS total_minutes, round((100.0 * total_exec_time / NULLIF(sum(total_exec_time) OVER (), 0))::numeric, 2) AS exec_percent, round(mean_exec_time::numeric, 2) AS mean_ms, calls, rows, query FROM pg_stat_statements ORDER BY total_exec_time DESC LIMIT 100;'

-- Development conveniences.
\set sp 'SHOW search_path;'
\set clear '\\! clear'
\set ll '\\! ls -lrt'

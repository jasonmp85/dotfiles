# This is the top-most EditorConfig file.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# gofmt uses tabs for indentation.
[*.go]
indent_style = tab
indent_size = tab
tab_width = 4

# Preserve Markdown hard line breaks.
[*.md]
trim_trailing_whitespace = false

# Rust uses four spaces.
[*.rs]
indent_size = 4

# Python uses four spaces.
[*.py]
indent_size = 4

# Make recipes require tabs.
[{GNUmakefile,GNUmakefile.*,Makefile,Makefile.*,*.mk}]
indent_style = tab
indent_size = tab
tab_width = 4

# git config writes tabs and conventionally displays them eight columns wide.
[{.gitconfig,gitconfig,gitconfig-*}]
indent_style = tab
indent_size = tab
tab_width = 8

# plutil -convert xml1 outputs tabs.
[*.{plist,terminal}]
indent_style = tab
indent_size = tab
tab_width = 4

# rapid.json conventionally uses four spaces.
[rapid.json]
indent_size = 4

instance_eval(File.read(File.join(__dir__, "Brewfile.core")))

tap "microsoft/mssql-release", "https://github.com/Microsoft/homebrew-mssql-release", trusted: true
tap "peonping/tap", "https://github.com/PeonPing/homebrew-tap", trusted: true
tap "petere/postgresql", trusted: true

# General-purpose data compression with high compression ratio
brew "xz"
# Cryptography and SSL/TLS Toolkit
brew "openssl@3"
# Securely store and access AWS credentials in development environments
brew "aws-vault"
# Library for command-line editing
brew "readline"
# Official Amazon AWS command-line interface
brew "awscli"
# YAML Parser
brew "libyaml"
# Microsoft Azure CLI 2.0
brew "azure-cli"
# Parser generator
brew "bison"
# User-friendly launcher for Bazel
brew "bazelisk"
# Format bazel BUILD files with a standard convention
brew "buildifier"
# GNU File, Shell, and Text utilities
brew "coreutils"
# TIFF library and utilities
brew "libtiff"
# Brokered message queue optimized for performance
brew "fq"
# ODBC 3 connectivity for UNIX
brew "unixodbc"
# Libraries to talk to Microsoft SQL Server and Sybase databases
brew "freetds"
# GNU compiler collection
brew "gcc"
# Shell script to install any Go version
brew "gimme"
# Open-source, cross-platform JavaScript runtime environment
brew "node"
# GNU Privacy Guard (OpenPGP)
brew "gnupg"
# Open source programming language to build simple/reliable/efficient software
brew "go"
# Like cURL, but for gRPC
brew "grpcurl"
# Kubernetes package manager
brew "helm"
# Generic command-line non-JVM Apache Kafka producer and consumer
brew "kcat"
# Tool that can switch between kubectl contexts easily and create aliases
brew "kubectx"
# Kubernetes command-line interface
brew "kubernetes-cli"
# Portable Foreign Function Interface library
brew "libffi"
# Utility for directing compilation
brew "make"
# Development kit for the Java programming language
brew "openjdk@21"
# Object-relational database system
brew "postgresql@17"
# Object-relational database system
brew "postgresql@18"
# Framework for managing multi-language pre-commit hooks
brew "pre-commit"
# Python version management
brew "pyenv"
# Interpreted, interactive, object-oriented programming language
brew "python@3.12"
# Interpreted, interactive, object-oriented programming language
brew "python@3.13"
# Powerful, clean, object-oriented scripting language
brew "ruby"
# Command-line interface for running and interacting with Temporal Server and UI
brew "temporal"
# Terraform version manager inspired by rbenv
brew "tfenv"
# ODBC Driver for Microsoft(R) SQL Server(R)
brew "microsoft/mssql-release/msodbcsql18"
# Sound effects and desktop notifications for AI coding agents
brew "peonping/tap/peon-ping"
# PostgreSQL database-cluster manager
brew "petere/postgresql/postgresql-common"

# Write, edit, and chat about your code with AI
cask "cursor"
# Set of tools to manage resources and applications hosted on Google Cloud
cask "gcloud-cli"
# Go (golang) IDE
cask "goland"
# Intercept, modify, replay, save HTTP/S traffic
cask "mitmproxy"

vscode "datadog.datadog-vscode"

go "github.com/fiatjaf/cbor"
go "github.com/CycloneDX/cyclonedx-gomod/cmd/cyclonedx-gomod"
go "github.com/DataDog/dd-go/domains/langtools/apps/ddgo"

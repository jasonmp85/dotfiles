# display red dots whilst waiting for completion.
COMPLETION_WAITING_DOTS="true"

# Keep completion security checks enabled; current completion paths pass compaudit.
ZSH_DISABLE_COMPFIX="false"

# Use four-column tab stops for direct terminal output.
[[ -t 1 ]] && tabs -4

# Docker Desktop installs its completion definitions here.
if [[ -d "${HOME}/.docker/completions" ]]; then
  fpath=("${HOME}/.docker/completions" $fpath)
fi

if [[ -n ${HOMEBREW_PREFIX:-} ]]; then
  antidote_script="${HOMEBREW_PREFIX}/opt/antidote/share/antidote/antidote.zsh"
elif [[ -r /opt/homebrew/opt/antidote/share/antidote/antidote.zsh ]]; then
  antidote_script=/opt/homebrew/opt/antidote/share/antidote/antidote.zsh
else
  antidote_script=/usr/local/opt/antidote/share/antidote/antidote.zsh
fi

if [[ -r "${antidote_script}" ]]; then
  source "${antidote_script}"
  antidote load "${HOME}/.zsh_plugins.txt"
else
  print -u2 "warning: antidote is not installed; run script/bootstrap"
fi
unset antidote_script

alias ush='ssh -F/dev/null'
alias bb='bbedit'
alias ku='kubectl'

export PYENV_ROOT="$HOME/.pyenv"
if (( $+commands[pyenv] )); then
  eval "$(pyenv init -)"
fi

# Search command history using the current buffer with the arrow keys.
HISTORY_SUBSTRING_SEARCH_ENSURE_UNIQUE=1
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
bindkey '^[OA' history-substring-search-up
bindkey '^[OB' history-substring-search-down

# 1Password shell plugins (generated per machine by `op plugin init`).
[[ -r "$HOME/.config/op/plugins.sh" ]] && source "$HOME/.config/op/plugins.sh"

# Prompt; keep last so it takes over from anything the plugins set.
(( $+commands[starship] )) && eval "$(starship init zsh)"

Host ddoghq.github.com
    HostName github.com

Host github.com ddoghq.github.com
    User git
    PubkeyAuthentication yes
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    PreferredAuthentications publickey

    StrictHostKeyChecking yes
    UserKnownHostsFile ~/.config/dotfiles/github-known-hosts
    VerifyHostKeyDNS no
    UpdateHostKeys no

    ForwardAgent no
    ForwardX11 no
    PermitLocalCommand no
    RequestTTY no

Host *
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

    HashKnownHosts yes

    ControlMaster auto
    ControlPath ~/.ssh/control-sockets/%C
    ControlPersist 10m

    ServerAliveInterval 5m
    ServerAliveCountMax 2

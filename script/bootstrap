#!/usr/bin/env bash

set -euo pipefail

scriptdir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
basedir="$(cd -- "${scriptdir}/.." && pwd)"
brewfile="${basedir}/dotfiles/Brewfile"

if [[ "$(uname -s)" != "Darwin" ]]; then
  >&2 echo "ERROR: This bootstrap script supports macOS only."
  exit 1
fi

if ! command -v brew >/dev/null 2>&1; then
  >&2 echo "ERROR: Homebrew is required. Install it from https://brew.sh, then rerun this script."
  exit 1
fi

>&2 echo "==> Installing applications and command-line tools..."
brew bundle install --file="${brewfile}"

"${scriptdir}/setup"

>&2 echo "==> Bootstrap complete!"
>&2 echo "==> Optional Terminal profile: ${basedir}/Black Sun.terminal"

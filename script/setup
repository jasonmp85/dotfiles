#!/usr/bin/env bash

set -euo pipefail
IFS=$'\n\t'

scriptdir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
basedir="$(cd -- "${scriptdir}/.." && pwd)"
dfdir="${basedir}/dotfiles"

>&2 echo "==> Linking dotfiles..."

status=0

while IFS= read -r -d '' dotfile; do
  dotdir="$(dirname "${dotfile}")"
  source_path="${dfdir}/${dotfile}"
  target_path="${HOME}/.${dotfile}"

  # TODO: copy permissions of dirname in git repo
  if [ "${dotdir}" != "." ]; then
    mkdir -p "${HOME}/.${dotdir}"
  fi

  if [[ -L "${target_path}" && "${target_path}" -ef "${source_path}" ]]; then
    >&2 echo "==> Already linked: ${target_path}"
    continue
  fi

  if [[ -e "${target_path}" || -L "${target_path}" ]]; then
    >&2 echo "ERROR: Refusing to overwrite ${target_path}"
    status=1
    continue
  fi

  ln -s "${source_path}" "${target_path}"
done < <(git -C "${dfdir}" ls-files -z)

if (( status != 0 )); then
  exit "${status}"
fi

managed_git_hooks="/usr/local/dd/global_hooks"
local_git_config="${HOME}/.config/git/config.local"

if [[ -d "${managed_git_hooks}" ]]; then
  mkdir -p "$(dirname "${local_git_config}")"
  git config --file "${local_git_config}" core.hooksPath "${managed_git_hooks}"
fi

>&2 echo "==> Dotfiles linked!"

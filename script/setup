#!/usr/bin/env bash

set -euo pipefail
IFS=$'\n\t'

scriptdir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
basedir="$(cd -- "${scriptdir}/.." && pwd)"
dfdir="${basedir}/dotfiles"

if ! git -C "${dfdir}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  >&2 echo "ERROR: ${basedir} is not a Git worktree. Clone the repository before running setup."
  exit 1
fi

>&2 echo "==> Linking dotfiles..."

status=0

install -d -m 700 "${HOME}/.ssh" "${HOME}/.ssh/control-sockets"

while IFS= read -r -d '' dotfile; do
  dotdir="$(dirname "${dotfile}")"
  source_path="${dfdir}/${dotfile}"
  target_path="${HOME}/.${dotfile}"

  if [ "${dotdir}" != "." ]; then
    mkdir -p "${HOME}/.${dotdir}"
  fi

  if [[ -L "${target_path}" && "${target_path}" -ef "${source_path}" ]]; then
    >&2 echo "==> Already linked: ${target_path}"
    continue
  fi

  if [[ -e "${target_path}" || -L "${target_path}" ]]; then
    >&2 echo "ERROR: Refusing to overwrite ${target_path}"
    status=1
    continue
  fi

  ln -s "${source_path}" "${target_path}"
  >&2 echo "==> Linked: ${target_path}"
done < <(git -C "${dfdir}" ls-files -z)

ensure_wrapper() {
  local target_path="$1"
  local required_line="$2"
  local initial_contents="$3"
  shift 3

  if [[ -L "${target_path}" ]]; then
    local link_target
    link_target="$(readlink "${target_path}")"
    local known_legacy_target
    local is_legacy=false

    for known_legacy_target in "$@"; do
      if [[ "${link_target}" == "${known_legacy_target}" ]]; then
        is_legacy=true
        break
      fi
    done

    if [[ "${is_legacy}" == true ]]; then
      unlink "${target_path}"
    else
      >&2 echo "ERROR: Refusing to replace unexpected symlink ${target_path} -> ${link_target}"
      status=1
      return
    fi
  fi

  if [[ ! -e "${target_path}" ]]; then
    printf '%s\n' "${initial_contents}" > "${target_path}"
    >&2 echo "==> Created wrapper: ${target_path}"
  elif grep -Fqx -- "${required_line}" "${target_path}"; then
    >&2 echo "==> Already configured: ${target_path}"
  else
    >&2 echo "ERROR: Refusing to modify ${target_path}; add this line manually:"
    >&2 printf '  %s\n' "${required_line}"
    status=1
  fi
}

ensure_wrapper \
  "${HOME}/.zshrc" \
  'source "$HOME/.config/dotfiles/zshrc"' \
  'source "$HOME/.config/dotfiles/zshrc"' \
  "${dfdir}/zshrc" \
  'Repos/dotfiles/dotfiles/zshrc'

ensure_wrapper \
  "${HOME}/.zprofile" \
  'source "$HOME/.config/dotfiles/zprofile"' \
  'source "$HOME/.config/dotfiles/zprofile"' \
  "${dfdir}/zprofile"

ensure_wrapper \
  "${HOME}/.ssh/config" \
  'Include ~/.config/dotfiles/ssh-config' \
  $'Include ~/.config/datadog/git/ssh_config\n\nInclude ~/.colima/ssh_config\n\nInclude ~/.config/dotfiles/ssh-config' \
  "${dfdir}/ssh/config"

if [[ -f "${HOME}/.ssh/config" && ! -L "${HOME}/.ssh/config" ]]; then
  chmod 600 "${HOME}/.ssh/config"
fi

if (( status != 0 )); then
  exit "${status}"
fi

managed_git_hooks="/usr/local/dd/global_hooks"
local_git_config="${HOME}/.config/git/config.local"

if [[ -d "${managed_git_hooks}" ]]; then
  mkdir -p "$(dirname "${local_git_config}")"
  git config --file "${local_git_config}" core.hooksPath "${managed_git_hooks}"
fi

>&2 echo "==> Dotfiles linked!"
